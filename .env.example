# Copy with: python3 scripts/init_env.py (generates unique local passwords).
# Local development only. Production uses managed secrets and HTTPS.
POSTGRES_DB=hr_testing
POSTGRES_USER=hr_owner
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AUTH_ENCRYPTION_KEY=
# Keep this key separate from encrypted database backups; never rotate implicitly.
AUTH_MAIL_MODE=file
APP_PUBLIC_URL=http://127.0.0.1:8088
# SMTP requires STARTTLS with certificate verification. Never put real secrets here.
SMTP_ADDR=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
DB_PORT=5432
API_PORT=8080
WEB_PORT=8088
COOKIE_SECURE=false
APP_ORIGINS=http://127.0.0.1:8088,http://localhost:8088,http://127.0.0.1:5173,http://localhost:5173

# Dedicated local Docker network; change both together if a subnet conflicts.
HR_DOCKER_SUBNET=172.30.254.0/24
HR_WEB_INTERNAL_IP=172.30.254.10
# Shared limit for candidate API calls per client IP (including office NAT).
CANDIDATE_IP_LIMIT_PER_MINUTE=600
